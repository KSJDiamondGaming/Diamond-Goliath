{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BOT,DASHBOARD -c green,cyan \"npm run bot:dev\" \"npm run dashboard:dev\"",
    "beta": "concurrently -n BOT,DASHBOARD -c yellow,cyan \"npm run bot:beta\" \"npm run dashboard:beta\"",
    "production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js",
    "bot:dev": "cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js",
    "bot:beta": "cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js",
    "dashboard:dev": "vite src/dashboard --host 0.0.0.0 --port 5173 --mode development",
    "dashboard:beta": "vite src/dashboard --host 0.0.0.0 --port 5183 --mode development",
    "build": "npm run doctor && vite build src/dashboard --outDir ../../dist --emptyOutDir --logLevel warn",
    "promote:beta": "node scripts/goliath.js promote beta",
    "promote:production": "node scripts/goliath.js promote production",
    "sync:commands": "node scripts/goliath.js sync-commands",
    "doctor": "node scripts/goliath.js doctor",
    "doctor:social": "node scripts/goliath.js doctor social",
    "audit": "node scripts/goliath.js audit"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^8.0.16"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
