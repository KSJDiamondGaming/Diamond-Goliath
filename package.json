{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
  "bot": "node server.js",
  "api": "node src/dashboard/server.js",
  "dashboard": "vite src/dashboard --host",
  "sync": "node src/helpers/commands/syncCommands.js",
  "dev": "npm run sync && concurrently -n BOT,API,DASH -c blue,green,magenta \"npm run bot\" \"npm run api\" \"npm run dashboard\""
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^5.0.0"
  }
}