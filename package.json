{
  "name": "Diamond-Goliath",
  "version": "1.0.0",
  "description": "All in on Goliath",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "bot": "node index.js",
    "api": "node dashboard/server/index.js",
    "client": "npm run dev --silent --prefix dashboard/client",
    "dev": "concurrently --names \"BOT,API,CLIENT\" --prefix \"[{name}]\" \"npm run bot --silent\" \"npm run api --silent\" \"npm run client --silent\"",
    "start": "npm run dev"
  },
  "dependencies": {
    "@railway/cli": "^4.40.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
