{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
 "scripts": {
  "bot": "node server.js",
  "bot:dev": "cross-env BOT_MODE=dev node server.js",
  "bot:beta": "cross-env BOT_MODE=beta node server.js",
  "bot:production": "cross-env BOT_MODE=production node server.js",

  "sync": "node src/helpers/commands/syncCommands.js",
  "sync:dev": "cross-env BOT_MODE=dev node src/helpers/commands/syncCommands.js",
  "sync:beta": "cross-env BOT_MODE=beta node src/helpers/commands/syncCommands.js",
  "sync:production": "cross-env BOT_MODE=production node src/helpers/commands/syncCommands.js",
  "sync:dev+beta": "npm run sync:dev && npm run sync:beta",

  "dashboard": "vite src/dashboard --host",
  "dashboard:dev": "vite src/dashboard --host 0.0.0.0 --port 5173 --mode development",
  "dashboard:beta": "vite src/dashboard --host 0.0.0.0 --port 5183 --mode development",
  "dashboard:production": "vite src/dashboard --host 0.0.0.0 --port 5193 --mode production",

  "dev": "concurrently -n BOT,DASHBOARD -c green,cyan \"npm run bot:dev\" \"npm run dashboard:dev\"",
  "dev:sync": "npm run sync:dev && npm run dev",

  "beta": "concurrently -n BOT,DASHBOARD -c yellow,cyan \"npm run bot:beta\" \"npm run dashboard:beta\"",
  "beta:sync": "npm run sync:beta && npm run beta",

  "production": "npm run bot:production",
  "production:sync": "npm run sync:production && npm run production",

  "dev+beta": "npm run sync:dev+beta && concurrently -n DEV,BETA -c blue,yellow \"npm run bot:dev\" \"npm run bot:beta\"",

  "api": "node server.js",
  "api:dev": "cross-env BOT_MODE=dev node server.js",
  "api:beta": "cross-env BOT_MODE=beta node server.js",
  "api:production": "cross-env BOT_MODE=production node server.js"
},
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.15.0",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^5.0.0"
  }
}