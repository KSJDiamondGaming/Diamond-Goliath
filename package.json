{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BOT,DASHBOARD -c green,cyan \"cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js\" \"vite src/dashboard --host 0.0.0.0 --port 5175 --mode development\"",
    "beta": "concurrently -n BOT,DASHBOARD -c yellow,cyan \"cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js\" \"vite src/dashboard --host 0.0.0.0 --port 5183 --mode development\"",
    "production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js",
    "build": "npm run doctor && vite build src/dashboard --outDir ../../dist --emptyOutDir --logLevel warn",
    "test": "npm run test:schedule",
    "test:schedule": "node --test test/schedule/*.test.js",
    "promote:beta": "node scripts/goliath.js promote beta",
    "promote:production": "node scripts/goliath.js promote production",
    "sync:commands": "node scripts/goliath.js sync-commands",
    "doctor": "node scripts/goliath.js doctor",
    "audit": "node scripts/goliath.js audit"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^8.0.16"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
