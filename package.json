{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot + Dashboard",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
  "dev": "npm run local:dashboard",

  "dev:dashboard": "vite --host 0.0.0.0",
  "dashboard": "npm run dev:dashboard",
  "dashboard:dev": "npm run dev:dashboard",
  "dashboard:build": "vite build --outDir dist/dashboard",
  "dashboard:preview": "vite preview --host 0.0.0.0",

  "core": "node server.js",
  "core:dev": "cross-env BOT_MODE=dev node server.js",
  "core:beta": "cross-env BOT_MODE=beta node server.js",
  "core:production": "cross-env BOT_MODE=production node server.js",

  "bot": "npm run core",
  "bot:dev": "npm run core:dev",
  "bot:beta": "npm run core:beta",
  "bot:production": "npm run core:production",

  "api": "npm run core",
  "api:dev": "npm run core:dev",
  "api:beta": "npm run core:beta",
  "api:production": "npm run core:production",

  "sync": "node src/helpers/commands/syncCommands.js",
  "sync:dev": "cross-env BOT_MODE=dev node src/helpers/commands/syncCommands.js",
  "sync:beta": "cross-env BOT_MODE=beta node src/helpers/commands/syncCommands.js",
  "sync:production": "cross-env BOT_MODE=production node src/helpers/commands/syncCommands.js",

  "local:dashboard": "concurrently -n CORE,DASH -c green,magenta \"npm run core:dev\" \"npm run dev:dashboard\"",
  "local:full": "concurrently -n CORE,DASH -c green,magenta \"npm run sync:dev && npm run core:dev\" \"npm run dev:dashboard\"",

  "beta": "npm run sync:beta && npm run core:beta",
  "production": "npm run sync:production && npm run core:production",

  "start": "npm run core:production"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.15.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^5.0.0"
  }
}