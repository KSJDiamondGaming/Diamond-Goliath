{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "bot": "node -r ./src/runtime/warningFilter.js server.js",
    "bot:dev": "cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js",
    "bot:beta": "cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js",
    "bot:production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js",
    "sync:commands": "node src/core/commandRegistry/syncCommands.js",
    "sync:commands:dev": "cross-env BOT_MODE=dev node src/core/commandRegistry/syncCommands.js",
    "sync:commands:beta": "cross-env BOT_MODE=beta node src/core/commandRegistry/syncCommands.js",
    "sync:commands:production": "cross-env BOT_MODE=production node src/core/commandRegistry/syncCommands.js",
    "commands:dev": "npm run sync:commands:dev",
    "commands:beta": "npm run sync:commands:beta",
    "commands:production": "npm run sync:commands:production",
    "sync:dev": "git add . && git commit -m \"dev sync\" && git push origin dev && ssh root@198.186.130.112 \"bash /home/goliath/deploy-dev.sh\"",
    "auto:dev": "powershell -ExecutionPolicy Bypass -File scripts/auto-push-dev.ps1",
    "promote:beta": "git checkout beta && git merge dev && git push origin beta && ssh root@198.186.130.112 \"bash /home/goliath/deploy-beta.sh\" && git checkout dev",
    "promote:production": "git checkout production && git merge beta && git push origin production && ssh root@198.186.130.112 \"bash /home/goliath/deploy-production.sh\" && git checkout dev",
    "dashboard": "vite src/dashboard --host",
    "dashboard:dev": "vite src/dashboard --host 0.0.0.0 --port 5173 --mode development",
    "dashboard:beta": "vite src/dashboard --host 0.0.0.0 --port 5183 --mode development",
    "dashboard:production": "vite src/dashboard --host 0.0.0.0 --port 5193 --mode production",
    "check": "node scripts/scripts.js check",
    "dashboard:build": "npm run check && vite build src/dashboard --outDir ../../dist --emptyOutDir",
    "build": "npm run dashboard:build",
    "dev": "concurrently -n BOT,DASHBOARD -c green,cyan \"npm run bot:dev\" \"npm run dashboard:dev\"",
    "dev:sync": "npm run sync:commands:dev && npm run dev",
    "beta": "concurrently -n BOT,DASHBOARD -c yellow,cyan \"npm run bot:beta\" \"npm run dashboard:beta\"",
    "beta:sync": "npm run sync:commands:beta && npm run beta",
    "production": "npm run bot:production",
    "production:sync": "npm run sync:commands:production && npm run production",
    "api": "node -r ./src/runtime/warningFilter.js server.js",
    "api:dev": "cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js",
    "api:beta": "cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js",
    "api:production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js",
    "audit": "node scripts/scripts.js runtime",
    "guilds:verify": "node scripts/scripts.js guilds"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^8.0.16"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
