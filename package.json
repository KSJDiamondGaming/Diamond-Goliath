{
  "name": "goliath",
  "version": "1.0.0",
  "description": "Goliath Discord Bot",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "npm run auto:dev && npm run dev:local",
    "dev:local": "concurrently -n BOT,DASHBOARD -c green,cyan \"npm run bot:dev\" \"npm run dashboard:dev\"",
    "beta": "concurrently -n BOT,DASHBOARD -c yellow,cyan \"npm run bot:beta\" \"npm run dashboard:beta\"",
    "production": "npm run bot:production",

    "bot": "node -r ./src/runtime/warningFilter.js server.js",
    "bot:dev": "cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js",
    "bot:beta": "cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js",
    "bot:production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js",

    "dashboard": "vite src/dashboard --host",
    "dashboard:dev": "vite src/dashboard --host 0.0.0.0 --port 5173 --mode development",
    "dashboard:beta": "vite src/dashboard --host 0.0.0.0 --port 5183 --mode development",
    "dashboard:production": "vite src/dashboard --host 0.0.0.0 --port 5193 --mode production",
    "dashboard:build": "npm run doctor && vite build src/dashboard --outDir ../../dist --emptyOutDir --logLevel warn",
    "build": "npm run dashboard:build",

    "auto:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-push.ps1 dev",
    "auto:beta": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-push.ps1 beta",
    "auto:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-push.ps1 production",

    "promote:beta": "git switch beta && git merge dev && git push origin beta && ssh root@198.186.130.112 \"bash /home/goliath/deploy-beta.sh\" && git switch dev",
    "promote:production": "git switch production && git merge beta && git push origin production && ssh root@198.186.130.112 \"bash /home/goliath/deploy-production.sh\" && git switch dev",

    "sync:commands": "node src/core/commandRegistry/syncCommands.js",
    "sync:commands:dev": "cross-env BOT_MODE=dev node src/core/commandRegistry/syncCommands.js",
    "sync:commands:beta": "cross-env BOT_MODE=beta node src/core/commandRegistry/syncCommands.js",
    "sync:commands:production": "cross-env BOT_MODE=production node src/core/commandRegistry/syncCommands.js",

    "doctor": "npm run check",
    "check": "node scripts/run-goliath-check.js check && node scripts/runtime-import-audit.js && node scripts/auto-roles-audit.js && node scripts/welcome-audit.js && node scripts/goodbye-audit.js && node scripts/module-standard-audit.js",
    "audit": "node scripts/run-goliath-check.js audit && node scripts/runtime-import-audit.js && node scripts/auto-roles-audit.js && node scripts/welcome-audit.js && node scripts/goodbye-audit.js && node scripts/module-standard-audit.js",
    "commands:audit": "node scripts/run-goliath-check.js commands",
    "dashboard:audit": "node scripts/run-goliath-check.js dashboard",
    "dashboard:audit-files": "node scripts/run-goliath-check.js dashboard:files",
    "dashboard:audit-routes": "node scripts/run-goliath-check.js dashboard:routes",
    "runtime:imports": "node scripts/runtime-import-audit.js",
    "runtime:check": "node scripts/run-goliath-check.js runtime",
    "modules:standard": "node scripts/module-standard-audit.js",
    "audit:auto-roles": "node scripts/auto-roles-audit.js",
    "audit:welcome": "node scripts/welcome-audit.js",
    "audit:goodbye": "node scripts/goodbye-audit.js",
    "guilds:verify": "node scripts/run-goliath-check.js guilds",
    "media:deps": "node scripts/check-media-deps.js",

    "api": "node -r ./src/runtime/warningFilter.js server.js",
    "api:dev": "cross-env BOT_MODE=dev node -r ./src/runtime/warningFilter.js server.js",
    "api:beta": "cross-env BOT_MODE=beta node -r ./src/runtime/warningFilter.js server.js",
    "api:production": "cross-env BOT_MODE=production node -r ./src/runtime/warningFilter.js server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "vite": "^8.0.16"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
